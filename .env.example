# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL / Neon / Supabase)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Auth.js / NextAuth
AUTH_SECRET="super-secret-auth-key-generate-with-openssl-rand-hex-32"
NEXTAUTH_URL=http://localhost:3000

# Google Cloud & Service Account
GOOGLE_PROJECT_ID="your-google-project-id"
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_APPLICATION_CREDENTIALS="./google-service-account.json"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Supabase Auth Configuration
# Google OAuth Callback configured in Google Cloud Console: https://your-project.supabase.co/auth/v1/callback
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_AUTH_CALLBACK_URL="https://your-project.supabase.co/auth/v1/callback"

# Google SMTP / Email Credentials (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="SUBAN Photography <noreply@subanphotography.com>"

# Cloudflare R2 Storage (Private Originals & Public Derived Assets)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_PRIVATE="suban-originals-private"
R2_BUCKET_PUBLIC="suban-assets-public"
R2_PUBLIC_DOMAIN="https://assets.subanphotography.com"

# Payment Gateways
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox" # sandbox or live

# Nepali Gateways (eSewa, Khalti, Fonepay)
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/Du7G2n5MtN"
KHALTI_SECRET_KEY="test_secret_key_..."
NEXT_PUBLIC_KHALTI_PUBLIC_KEY="test_public_key_..."
FONEPAY_MERCHANT_CODE="your-fonepay-merchant-code"
FONEPAY_SECRET_KEY="your-fonepay-secret"

# Security & Monitoring
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
